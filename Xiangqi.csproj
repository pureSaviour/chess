<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Godot 4.7.2's prebuilt Android export template currently reports net9.0 as
         its supported TFM. Keep Android on net9.0 until a supported net10.0 export
         path has been confirmed with official guidance and an actual export. -->
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Xiangqi</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/Presentation/**/*.cs" />
    <ProjectReference Include="src/Xiangqi.Core/Xiangqi.Core.csproj" />
    <ProjectReference Include="src/Xiangqi.Transport/Xiangqi.Transport.csproj" />
    <!-- Steamworks.NET is pinned to the SDK 1.65-compatible upstream commit documented
         in third_party/Steamworks.NET/NOTICE.md. Steam is a Windows desktop feature;
         Android exports deliberately omit both the managed binding and native DLL. -->
    <Reference Include="Steamworks.NET" Condition=" '$(GodotTargetPlatform)' == 'windows' ">
      <HintPath>third_party/Steamworks.NET/Steamworks.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="steam_api64.dll" Condition=" '$(GodotTargetPlatform)' == 'windows' " CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
